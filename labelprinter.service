[Unit]
Description=Labelprinter web + REST service (Brother QL-570)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/labelprinter
ExecStart=/opt/labelprinter/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
